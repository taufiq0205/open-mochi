# Copy to .env and fill in your own provider credentials.
# Never put secret keys in NEXT_PUBLIC_ variables.
# Generate once: openssl rand -hex 32. Keep stable across restarts.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Generate a URL-safe password: openssl rand -hex 32.
# Compose injects the local DATABASE_URL; PostgreSQL has no published host port.
POSTGRES_PASSWORD=
# For web/worker processes outside Compose, supply a reachable PostgreSQL URL.
# The Compose hostname "postgres" is reachable only on its Docker network.
# DATABASE_URL=postgresql://mochi:YOUR_PASSWORD@YOUR_DATABASE_HOST:5432/mochi

# Server-only DeepSeek key for AI chat.
DEEPSEEK_API_KEY=

# Server-only OpenSandbox key; generate once with openssl rand -hex 32.
# Compose supplies this key to the local server and web application.
OPEN_SANDBOX_API_KEY=
# Web and deployed workers need a reachable server URL; host scripts use localhost:8085.
OPEN_SANDBOX_DOMAIN=http://host.docker.internal:8085
OPEN_SANDBOX_IMAGE=open-mochi-sandbox:local
# Browser-reachable desktop relay; reverse-proxy with TLS for remote access.
DESKTOP_PROXY_URL=ws://localhost:3001
DESKTOP_PROXY_PORT=3001

# Self-hosted Trigger project and Production environment key (not a Cloud key).
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=
# Host CLI/server address; Compose overrides the server address internally.
TRIGGER_API_URL=http://localhost:8030
# Browser-reachable URL, embedded at image build time. Rebuild after changing.
NEXT_PUBLIC_TRIGGER_API_URL=http://localhost:8030
# Configure DATABASE_URL, DEEPSEEK_API_KEY, and OPEN_SANDBOX_API_KEY
# in the Trigger.dev worker environment too.

# Optional monitoring; blank disables sending events.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional source-map upload token for local/worker builds; never a Docker build arg.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
